{
  "name": "kemon-ache-bangladesh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:sources": "vitest run tests/sources.test.tsx",
    "check:data": "tsx scripts/validate-data.ts",
    "check": "npm run typecheck && npm run check:i18n && npm run check:data && npm test",
    "data:refresh": "tsx scripts/refresh.ts",
    "data:availability": "tsx scripts/data-availability.ts",
    "assets": "tsx scripts/generate-background.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/anek-bangla": "^5.3.0",
    "@fontsource/tiro-bangla": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "read-excel-file": "^9.3.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
